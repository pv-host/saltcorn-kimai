  "keywords": [
    "saltcorn",
    "saltcorn-plugin",
    "kimai",
    "zeiterfassung",
    "timesheet"
  ],
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY-REVIEW.md"
  ],
  "devDependencies": {
    "@saltcorn/data": "1.6.2",
    "@saltcorn/markup": "1.6.2"
  }
}
