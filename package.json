{
  "name": "saltcorn-kimai",
  "version": "0.5.0",
  "description": "Saltcorn-Plugin: Kimai-Zeiterfassung lesend einbinden – Kunden, Projekte, Tätigkeiten und Stundeneinträge je Datensatz (z.B. Entity), Zuordnung über Vorlagen und Variablen",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run-tests.js",
    "test:security": "node --test security-tests/regression.test.js",
    "test:all": "npm test && npm run test:security"
